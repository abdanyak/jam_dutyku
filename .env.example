# Discord Bot Credentials
# Buat bot di: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=masukkan_token_bot_discord_disini

# ID Channel Discord tempat kamu mengirim pesan absen
DISCORD_CHANNEL_ID=masukkan_id_channel_discord_disini

# Nama Steam yang ingin dipantau (default: Kawa, atau isi 'all' jika ingin semua)
TARGET_STEAM_NAME=Kawa
